# Braid Boss Pro — environment variables
#
# Copy to `.env.local` for local dev and fill in real values:
#   cp .env.example .env.local
#
# NEVER commit real secrets. `.env.local` is gitignored; only this
# example (with placeholder values) is tracked.
#
# Vars prefixed NEXT_PUBLIC_ are exposed to the browser — put ONLY
# non-secret, publishable values there. Everything else is server-only.
#
# This file documents the Next.js app (app/ + app/api/). The Supabase
# edge functions (supabase/functions/) read their own secrets, which are
# set in the Supabase dashboard, not here — see the bottom of this file.

# ── Supabase ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
# Server-only. Full-access key — bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional server-side fallback for the URL (some routes read either name).
SUPABASE_URL=https://your-project-ref.supabase.co

# ── App URLs ────────────────────────────────────────────────────────────
# Canonical public origin, used to build links in emails/redirects.
NEXT_PUBLIC_SITE_URL=https://braidbosspro.app
APP_PUBLIC_URL=https://braidbosspro.app

# ── Admin ───────────────────────────────────────────────────────────────
# Email of the single platform owner allowed into /admin. Also enforced
# server-side (isAdminUser) and again inside the SECURITY DEFINER RPCs.
NEXT_PUBLIC_ADMIN_EMAIL=owner@example.com

# ── Stripe (payments + Connect) ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_or_test_...
# Platform fee applied to Connect charges (basis points, e.g. 250 = 2.5%).
PLATFORM_FEE_BPS=250
NEXT_PUBLIC_PLATFORM_FEE_NOTE=Includes a small platform fee.
# One signing secret PER Stripe webhook endpoint. Each route verifies its
# own — do not share one secret across endpoints.
STRIPE_DEPOSIT_WEBHOOK_SECRET=whsec_...
STRIPE_BALANCE_WEBHOOK_SECRET=whsec_...
STRIPE_PRODUCT_WEBHOOK_SECRET=whsec_...
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=whsec_...
STRIPE_SMS_WEBHOOK_SECRET=whsec_...
STRIPE_FOUNDING_WEBHOOK_SECRET=whsec_...

# ── Email (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@braidbosspro.app

# ── Maps / geocoding (Mapbox) ───────────────────────────────────────────
MAPBOX_TOKEN=pk....

# ── Shipping (Shippo) ───────────────────────────────────────────────────
# Per-account Shippo tokens are stored per stylist; this secret verifies
# inbound Shippo webhooks.
SHIPPO_WEBHOOK_SECRET=your-shippo-webhook-secret

# ── Web push (VAPID) ────────────────────────────────────────────────────
# Public key is safe to ship to the browser; the private key lives with
# the edge functions (see below), not here.
NEXT_PUBLIC_PUSH_VAPID_PUBLIC_KEY=your-vapid-public-key

# ════════════════════════════════════════════════════════════════════════
# Supabase EDGE FUNCTION secrets (set in the Supabase dashboard, NOT here)
#   Dashboard → Project → Edge Functions → Secrets, or:
#     supabase secrets set NAME=value --project-ref <ref>
#
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
#   NEXT_PUBLIC_SITE_URL
#   RESEND_API_KEY, RESEND_FROM_EMAIL, RESEND_MARKETING_FROM_EMAIL
#   JWT_SECRET                        (calendar-feed token signing)
#   VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT   (send-push)
#   TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_PHONE_NUMBER
#   TWILIO_MESSAGING_SERVICE_SID
#   TWILIO_INBOUND_PUBLIC_URL, TWILIO_STATUS_PUBLIC_URL,
#   TWILIO_STATUS_CALLBACK_URL
# ════════════════════════════════════════════════════════════════════════
